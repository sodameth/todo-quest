{
  "expo": {
    "name": "Todo Quest",
    "slug": "todo-quest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f0c18"
    },
    "assetBundlePatterns": ["**/*"],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.todoquest.app",
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0c18"
      },
      "package": "com.todoquest.app",
      "permissions": ["VIBRATE", "RECEIVE_BOOT_COMPLETED"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#facc15"
        }
      ],
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "QR 코드를 스캔하여 퀘스트를 완료하려면 카메라 접근이 필요합니다."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildSettings": {
              "ENABLE_USER_SCRIPT_SANDBOXING": "NO"
            }
          }
        }
      ]
    ]
  }
}
